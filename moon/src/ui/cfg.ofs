        _t("det_renpy", "Pasta renpy/ e game/ com .rpa, .rpy ou .rpyc; versão em game/script_version.txt", "renpy/ and game/ folders with .rpa, .rpy or .rpyc; version in game/script_version.txt", "Carpetas renpy/ y game/ con .rpa, .rpy o .rpyc; versión en game/script_version.txt")
        _t("det_unity", "Pasta *_Data com globalgamemanagers; empresa e produto em app.info", "*_Data folder with globalgamemanagers; company and product in app.info", "Carpeta *_Data con globalgamemanagers; empresa y producto en app.info")
        _t("det_windows", "Arquivo .exe sem outro motor reconhecido", "An .exe file with no other known engine", "Un archivo .exe sin otro motor reconocido")
        _t("pl_moon_desc", "Roda o MOON. (Tactics, 1997) a partir dos arquivos originais: converte scripts e imagens no celular e toca com o player do M.O.O.N, com save/load, auto, pular, histórico e patches de tradução.", "Runs MOON. (Tactics, 1997) from the original files: converts scripts and images on the phone and plays them in the M.O.O.N player, with save/load, auto, skip, backlog and translation patches.", "Ejecuta MOON. (Tactics, 1997) desde los archivos originales: convierte scripts e imágenes en el teléfono y los reproduce en el reproductor de M.O.O.N, con guardar/cargar, auto, saltar, historial y parches de traducción.")
        _t("pl_renpy_desc", "Vai rodar jogos Ren'Py com o motor original do jogo (Python e módulos do Ren'Py para Android). Por enquanto o M.O.O.N já detecta o jogo, a versão do Ren'Py e mostra na biblioteca.", "Will run Ren'Py games with the game's original engine (Python and Ren'Py modules for Android). For now M.O.O.N detects the game and its Ren'Py version and lists it in the library.", "Ejecutará juegos Ren'Py con el motor original del juego (Python y módulos de Ren'Py para Android). Por ahora M.O.O.N detecta el juego y su versión de Ren'Py y lo muestra en la biblioteca.")
        _t("pl_unity_desc", "Jogos Unity para Windows precisam de uma camada de compatibilidade. O plugin está planejado; por enquanto o jogo aparece na biblioteca com empresa e produto.", "Unity games for Windows need a compatibility layer. The plugin is planned; for now the game is listed with company and product.", "Los juegos Unity para Windows necesitan una capa de compatibilidad. El plugin está planeado; por ahora el juego aparece con empresa y producto.")
        _t("pl_windows_desc", "Programas .exe do Windows precisam de uma camada de compatibilidade. O plugin está planejado; por enquanto o jogo só aparece na biblioteca.", "Windows .exe programs need a compatibility layer. The plugin is planned; for now the game is only listed.", "Los programas .exe de Windows necesitan una capa de compatibilidad. El plugin está planeado; por ahora el juego solo aparece en la biblioteca.")
