// M.O.O.N - configuracoes do app (files/config.json), tema e traducoes.
//
// Os textos da interface passam por tr("chave"): pt (padrao), en, es.

attach {hashmap}
attach {F:../core/bytes.ofs}
attach {F:../core/json.ofs}

namespace cfg {
    forge path: obsidian = ""
    forge lang: obsidian = "pt"
    forge theme: stone = 0           // ver "temas" abaixo (0 preto e branco)
    forge text_size: stone = 100     // %
    forge text_speed: stone = 45     // caracteres/s (0 = instantaneo)
    forge auto_delay: stone = 12     // decimos de segundo apos a fala (auto)
    forge ctrl_opacity: stone = 70   // %
    forge ctrl_size: stone = 100     // %
    forge dpad_side: stone = 0       // 0 esquerda, 1 direita
    forge pad_show: stone = 1        // gamepad na tela (D-pad + 4 botoes)
    forge pad_style: stone = 1       // 0 teclado, 1 Xbox, 2 PlayStation, 3 Nintendo
    forge pad_swap: stone = 0        // bit = estilo: confirmar/cancelar trocados (PS: bit 2 = japones)
    forge pad_auto: stone = 1        // esconde o gamepad com controle fisico
    forge orientation: stone = 0     // 0 auto, 1 retrato, 2 paisagem
    forge vol_bgm: stone = 80
    forge vol_voice: stone = 100
    forge vol_master: stone = 100
    forge game_lang: obsidian = "en" // textos do MOON.: en (com patch) ou ja
    forge settings_tab: stone = 0
    forge player_orient: stone = 2   // player: 2 paisagem (padrao), 1 retrato
    forge plugin_default: obsidian = "https://github.com/Samwns/M.O.O.N/releases/latest/download/index.json"
    forge plugin_index: obsidian = "https://github.com/Samwns/M.O.O.N/releases/latest/download/index.json" // URL do index.json dos plugins (https://, file:// ou caminho); vazio = so pacotes locais

    vein load(p: obsidian) -> void {
        path = p
        forge o = json.load(p)
        if (!json.is_obj(o)) { return }
        lang = json.gs(o, "lang", lang)
        theme = json.gi(o, "theme", theme)
        text_size = json.gi(o, "text_size", text_size)
        text_speed = json.gi(o, "text_speed", text_speed)
        auto_delay = json.gi(o, "auto_delay", auto_delay)
        ctrl_opacity = json.gi(o, "ctrl_opacity", ctrl_opacity)
        ctrl_size = json.gi(o, "ctrl_size", ctrl_size)
        dpad_side = json.gi(o, "dpad_side", dpad_side)
        pad_show = json.gi(o, "pad_show", pad_show)
        pad_style = json.gi(o, "pad_style", pad_style)
        pad_swap = json.gi(o, "pad_swap", pad_swap)
        pad_auto = json.gi(o, "pad_auto", pad_auto)
        orientation = json.gi(o, "orientation", orientation)
        vol_bgm = json.gi(o, "vol_bgm", vol_bgm)
        vol_voice = json.gi(o, "vol_voice", vol_voice)
        vol_master = json.gi(o, "vol_master", vol_master)
        game_lang = json.gs(o, "game_lang", game_lang)
        player_orient = json.gi(o, "player_orient", player_orient)
        plugin_index = tx.copy(json.gs(o, "plugin_index", plugin_index))
        // configs antigas gravavam "" por padrao: sem a marca plugin_index_set, vazio = padrao
        if (tx.len(plugin_index) == 0 && json.gi(o, "plugin_index_set", 0) == 0) { plugin_index = plugin_default }
        custom = []
        forge cc = json.first(json.get(o, "custom_colors"))
        while (cc >= 0) {
            ofs_array_push(custom, json.ival(cc))
            cc = json.next(cc)
        }
        if (ofs_array_len(custom) < COLOR_COUNT) {
            custom = []
            if (theme == 6) { theme = 0 }
        }
    }

    vein save() -> void {
        if (tx.len(path) == 0) { return }
        forge m = json.mark()
        forge o = json.obj()
        json.put_s(o, "lang", lang)
        json.put_i(o, "theme", theme)
        json.put_i(o, "text_size", text_size)
        json.put_i(o, "text_speed", text_speed)
        json.put_i(o, "auto_delay", auto_delay)
        json.put_i(o, "ctrl_opacity", ctrl_opacity)
        json.put_i(o, "ctrl_size", ctrl_size)
        json.put_i(o, "dpad_side", dpad_side)
        json.put_i(o, "pad_show", pad_show)
        json.put_i(o, "pad_style", pad_style)
        json.put_i(o, "pad_swap", pad_swap)
        json.put_i(o, "pad_auto", pad_auto)
        json.put_i(o, "orientation", orientation)
        json.put_i(o, "vol_bgm", vol_bgm)
        json.put_i(o, "vol_voice", vol_voice)
        json.put_i(o, "vol_master", vol_master)
        json.put_s(o, "game_lang", game_lang)
        json.put_i(o, "player_orient", player_orient)
        json.put_s(o, "plugin_index", plugin_index)
        json.put_i(o, "plugin_index_set", 1)
        if (ofs_array_len(custom) >= COLOR_COUNT) {
            forge ca = json.arr()
            forge ck = 0
            while (ck < COLOR_COUNT) {
                json.push(ca, json.int(ofs_array_get(custom, ck)))
                ck++
            }
            json.put(o, "custom_colors", ca)
        }
        json.save(path, o, "  ")
        json.release(m)
    }

    // ── tema ─────────────────────────────────────────────────────────────
    // ── temas ────────────────────────────────────────────────────────────
    // 11 cores por tema (0xRRGGBB): 0 fundo, 1 superficie, 2 texto, 3 texto secundario,
    // 4 destaque, 5 botao, 6 botao pressionado, 7 barra, 8 borda, 9 selo do motor, 10 caixa de texto do player.
    // Temas: 0 preto e branco (padrao), 1 roxo, 2 claro, 3 lua azul, 4 sepia, 5 floresta, 6 personalizado.
    forge THEME_COUNT: stone = 7
    forge COLOR_COUNT: stone = 11
    forge custom: Array<stone> = []

    vein _mix(a: stone, b: stone, pct: stone) -> stone {
        forge r = (((a >> 16) & 255) * (100 - pct) + ((b >> 16) & 255) * pct) / 100
        forge g = (((a >> 8) & 255) * (100 - pct) + ((b >> 8) & 255) * pct) / 100
        forge bl = ((a & 255) * (100 - pct) + (b & 255) * pct) / 100
        return (r << 16) | (g << 8) | bl
    }

    // tema simples: fundo, barra, superficie, texto, secundario, destaque
    vein _mk(bg: stone, bar: stone, surf: stone, fg: stone, muted: stone, acc: stone) -> Array<stone> {
        forge o: Array<stone> = []
        ofs_array_push(o, bg)
        ofs_array_push(o, surf)
        ofs_array_push(o, fg)
        ofs_array_push(o, muted)
        ofs_array_push(o, acc)
        ofs_array_push(o, acc)
        ofs_array_push(o, _mix(acc, surf, 35))
        ofs_array_push(o, bar)
        ofs_array_push(o, _mix(surf, bg, 50))
        ofs_array_push(o, bar)
        ofs_array_push(o, bg)
        return o
    }

    vein theme_colors(i: stone) -> Array<stone> {
        if (i == 1) { return _mk(1052704, 1513768, 2105394, 15132390, 9474224, 9136639) }
        if (i == 2) { return _mk(15921906, 16777215, 16777215, 2105376, 7368816, 6044864) }
        if (i == 3) { return _mk(726570, 1121337, 1516104, 14674175, 8423592, 7130623) }
        if (i == 4) { return _mk(2499360, 3157030, 3815216, 15784136, 11050128, 14191192) }
        if (i == 5) { return _mk(727310, 1055251, 1450522, 15003622, 9413015, 6279053) }
        if (i == 6 && ofs_array_len(custom) >= COLOR_COUNT) { return custom }
        // 0: preto e branco
        forge o: Array<stone> = [0, 1315860, 16777215, 10526880, 16777215, 15132390, 11051176, 658186, 2763306, 1973790, 0]
        return o
    }

    vein color(k: stone) -> stone {
        forge c = theme_colors(theme)
        return ofs_array_get(c, k)
    }

    // caixa de texto do player (cor do tema)
    vein textbox() -> stone { return color(10) }

    vein apply_theme() -> void {
        forge c = theme_colors(theme)
        forge surf: stone = ofs_array_get(c, 1)
        forge fg: stone = ofs_array_get(c, 2)
        forge hi = _mix(surf, fg, 12)
        oal.set_palette_full(ofs_array_get(c, 0), ofs_array_get(c, 7), surf, hi, fg, ofs_array_get(c, 3), ofs_array_get(c, 4), ofs_array_get(c, 5), ofs_array_get(c, 6), ofs_array_get(c, 8), ofs_array_get(c, 9))
    }

    // comeca o tema personalizado a partir do tema atual
    vein start_custom() -> void {
        if (theme != 6) {
            forge c = theme_colors(theme)
            custom = []
            forge k = 0
            while (k < COLOR_COUNT) {
                ofs_array_push(custom, ofs_array_get(c, k))
                k++
            }
        }
        theme = 6
    }

    vein set_color(k: stone, rgb: stone) -> void {
        start_custom()
        ofs_array_set(custom, k, rgb & 16777215)
    }

    vein reset_theme() -> void {
        theme = 0
        custom = []
    }

    vein theme_name(i: stone) -> obsidian {
        if (i == 1) { return tr("tema_roxo") }
        if (i == 2) { return tr("tema_claro") }
        if (i == 3) { return tr("tema_azul") }
        if (i == 4) { return tr("tema_sepia") }
        if (i == 5) { return tr("tema_floresta") }
        if (i == 6) { return tr("tema_custom") }
        return tr("tema_noite")
    }

    vein color_name(k: stone) -> obsidian {
        return tr("cor_" + tx.num(k))
    }

    vein hex(rgb: stone) -> obsidian {
        forge d = "0123456789ABCDEF"
        forge out = "#"
        forge k = 5
        while (k >= 0) {
            out = out + tx.sub(d, (rgb >> (k * 4)) & 15, 1)
            k--
        }
        return out
    }

    forge _keys: Array<obsidian> = []
    forge _pt: Array<obsidian> = []
    forge _en: Array<obsidian> = []
    forge _es: Array<obsidian> = []
    forge _idx: stone = -1

    vein _h(s: obsidian) -> stone {
        forge h = -3750763034362895579
        forge i = 0
        while (i < tx.len(s)) {
            h = (h ^ tx.at(s, i)) * 1099511628211
            i++
        }
        return h
    }

    vein _t(k: obsidian, pt: obsidian, en: obsidian, es: obsidian) -> void {
        ofs_array_push(_keys, k)
        ofs_array_push(_pt, pt)
        ofs_array_push(_en, en)
        ofs_array_push(_es, es)
        hashmap.set(_idx, _h(k), ofs_array_len(_keys) - 1)
    }

    vein tr_lang(k: obsidian, l: obsidian) -> obsidian {
        if (_idx < 0) { _init() }
        forge i = hashmap.get(_idx, _h(k), -1)
        if (i < 0) { return k }
        if (tx.eq(l, "en")) { return ofs_array_get(_en, i) }
        if (tx.eq(l, "es")) { return ofs_array_get(_es, i) }
        return ofs_array_get(_pt, i)
    }

    vein _init() -> void {
        _idx = hashmap.new(512)
        _t("biblioteca", "Biblioteca", "Library", "Biblioteca")
        _t("n_jogos", "jogos na biblioteca", "games in the library", "juegos en la biblioteca")
        _t("um_jogo", "1 jogo na biblioteca", "1 game in the library", "1 juego en la biblioteca")
        _t("vazio_bib", "Toque em + para adicionar um jogo", "Tap + to add a game", "Toca + para añadir un juego")
        _t("buscar", "Buscar na biblioteca", "Search the library", "Buscar en la biblioteca")
        _t("nada_busca", "Nenhum jogo com esse nome.", "No game with that name.", "Ningún juego con ese nombre.")
        _t("importar", "Importar", "Import", "Importar")
        _t("importar_jogo", "Importar jogo", "Import game", "Importar juego")
        _t("arquivos", "Arquivos", "Files", "Archivos")
        _t("plugins", "Plugins", "Plugins", "Plugins")
        _t("config", "Configurações", "Settings", "Ajustes")
        _t("personalizar", "Personalização e ajustes", "Personalization", "Personalización")
        _t("perm_titulo", "Acesso aos arquivos", "File access", "Acceso a los archivos")
        _t("perm_texto", "Para encontrar e importar os jogos que você copiou para o celular (por exemplo em Download), o M.O.O.N precisa da permissão \"Acesso a todos os arquivos\". Ele só lê as pastas dos jogos; nada é apagado nem enviado para fora do aparelho.", "To find and import the games you copied to the phone (for example in Download), M.O.O.N needs the \"All files access\" permission. It only reads the game folders; nothing is deleted or sent off the device.", "Para encontrar e importar los juegos que copiaste al teléfono (por ejemplo en Download), M.O.O.N necesita el permiso \"Acceso a todos los archivos\". Solo lee las carpetas de los juegos; no se borra ni se envía nada fuera del aparato.")
        _t("perm_passos", "Toque no botão abaixo, ative \"Permitir acesso para gerenciar todos os arquivos\" e volte para o app.", "Tap the button below, turn on \"Allow access to manage all files\" and come back to the app.", "Toca el botón de abajo, activa \"Permitir acceso para administrar todos los archivos\" y vuelve a la app.")
        _t("perm_botao", "Permitir acesso", "Allow access", "Permitir acceso")
        _t("perm_ok", "Acesso a todos os arquivos: liberado", "All files access: granted", "Acceso a todos los archivos: concedido")
        _t("perm_nao", "Acesso a todos os arquivos: não liberado", "All files access: not granted", "Acceso a todos los archivos: no concedido")
        _t("perm_falhou", "Não foi possível abrir as configurações do sistema", "Could not open the system settings", "No se pudieron abrir los ajustes del sistema")
        _t("imp_titulo", "Importar jogo", "Import game", "Importar juego")
        _t("imp_texto", "Pastas encontradas em Download e em files/import. Toque em um jogo para adicioná-lo à biblioteca.", "Folders found in Download and files/import. Tap a game to add it to the library.", "Carpetas encontradas en Download y files/import. Toca un juego para añadirlo a la biblioteca.")
        _t("imp_vazio", "Nenhuma pasta encontrada. Copie a pasta do jogo para Download ou para files/import.", "No folder found. Copy the game folder to Download or files/import.", "No se encontró ninguna carpeta. Copia la carpeta del juego a Download o files/import.")
        _t("imp_outra", "Escolher outra pasta", "Choose another folder", "Elegir otra carpeta")
        _t("imp_atualizar", "Procurar de novo", "Scan again", "Buscar de nuevo")
        _t("imp_ja", "já está na biblioteca", "already in the library", "ya está en la biblioteca")
        _t("imp_conv", "Convertendo MOON.", "Converting MOON.", "Convirtiendo MOON.")
        _t("imp_cancelar", "Cancelar", "Cancel", "Cancelar")
        _t("imp_scripts", "Scripts", "Scripts", "Scripts")
        _t("imp_imagens", "Imagens", "Images", "Imágenes")
        _t("imp_tamanho", "Calculando tamanho", "Measuring size", "Calculando tamaño")
        _t("imp_feito", "Adicionado à biblioteca", "Added to the library", "Añadido a la biblioteca")
        _t("imp_cancelado", "Importação cancelada", "Import cancelled", "Importación cancelada")
        _t("imp_aviso", "A conversão roda no celular e não trava a tela. Pode levar alguns minutos.", "The conversion runs on the phone without freezing the screen. It may take a few minutes.", "La conversión se hace en el teléfono sin bloquear la pantalla. Puede tardar unos minutos.")
        _t("motor", "Motor", "Engine", "Motor")
        _t("versao", "Versão", "Version", "Versión")
        _t("tamanho", "Tamanho", "Size", "Tamaño")
        _t("pasta", "Pasta", "Folder", "Carpeta")
        _t("empresa", "Empresa", "Company", "Empresa")
        _t("executavel", "Executável", "Executable", "Ejecutable")
        _t("adicionado", "Adicionado em", "Added on", "Añadido el")
        _t("jogar", "Jogar", "Play", "Jugar")
        _t("continuar", "Continuar", "Continue", "Continuar")
        _t("carregar", "Carregar", "Load", "Cargar")
        _t("salvar", "Salvar", "Save", "Guardar")
        _t("instalar_plugin", "Instalar plugin", "Install plugin", "Instalar plugin")
        _t("nao_suportado", "Não suportado", "Not supported", "No compatible")
        _t("st_pronto", "Pronto para jogar", "Ready to play", "Listo para jugar")
        _t("st_plugin", "Precisa de plugin", "Needs a plugin", "Necesita un plugin")
        _t("st_nao", "Não suportado ainda", "Not supported yet", "Aún no compatible")
        _t("st_falta", "Pasta do jogo não encontrada", "Game folder not found", "Carpeta del juego no encontrada")
        _t("plugin_breve", "O plugin deste motor ainda não está disponível. Ele vai rodar o motor original do jogo.", "The plugin for this engine is not available yet. It will run the game's original engine.", "El plugin de este motor aún no está disponible. Ejecutará el motor original del juego.")
        _t("patches", "Patches de tradução", "Translation patches", "Parches de traducción")
        _t("patch_nenhum", "Nenhum patch instalado.", "No patch installed.", "Ningún parche instalado.")
        _t("patch_incluso", "Instalar patch PT-BR incluso", "Install bundled PT-BR patch", "Instalar parche PT-BR incluido")
        _t("patch_arquivo", "Importar patch", "Import patch", "Importar parche")
        _t("patch_exportar", "Exportar modelo", "Export template", "Exportar modelo")
        _t("patch_exportado", "Modelo salvo em", "Template saved to", "Modelo guardado en")
        _t("patch_exportar_vazio", "Nenhuma string encontrada para exportar", "No strings found to export", "No se encontraron cadenas para exportar")
        _t("patch_remover", "Remover patch selecionado", "Remove selected patch", "Quitar parche seleccionado")
        _t("patch_remover_confirma", "Toque de novo para remover o patch (o jogo não é apagado)", "Tap again to remove the patch (the game is not deleted)", "Toca de nuevo para quitar el parche (el juego no se borra)")
        _t("patch_removido", "Patch removido", "Patch removed", "Parche quitado")
        _t("descricao", "Descrição", "Description", "Descripción")
        _t("descricao_editar", "Editar descrição", "Edit description", "Editar descripción")
