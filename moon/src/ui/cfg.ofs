        _t("aba_config", "Configurações", "Settings", "Ajustes")
        _t("aba_pers", "Personalização", "Personalize", "Personalizar")
        _t("idioma", "Idioma", "Language", "Idioma")
        _t("armazenamento", "Armazenamento", "Storage", "Almacenamiento")
        _t("abrir_pasta_app", "Abrir pasta do app", "Open app folder", "Abrir carpeta de la app")
        _t("permissoes", "Permissões", "Permissions", "Permisos")
        _t("sobre", "Sobre", "About", "Acerca de")
        _t("sobre_texto", "M.O.O.N 0.2 - biblioteca e player de visual novels escrito 100% em OFS (Obsidian Fault Script) com interface em OAL. Roda o MOON. (Tactics, 1997) nativamente a partir dos arquivos originais do jogo.", "M.O.O.N 0.2 - visual novel library and player written 100% in OFS (Obsidian Fault Script) with an OAL interface. Runs MOON. (Tactics, 1997) natively from the original game files.", "M.O.O.N 0.2 - biblioteca y reproductor de novelas visuales escrito 100% en OFS (Obsidian Fault Script) con interfaz OAL. Ejecuta MOON. (Tactics, 1997) de forma nativa desde los archivos originales del juego.")
        _t("tema", "Tema", "Theme", "Tema")
