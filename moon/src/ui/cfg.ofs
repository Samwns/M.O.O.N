        _t("sv_nada_apagar", "Nenhum arquivo para apagar", "No files to delete", "Ningún archivo para borrar")
        _t("sv_apagado", "Saves apagados", "Saves deleted", "Saves borrados")
        _t("sv_backup_auto", "backup automático", "automatic backup", "copia automática")
        _t("sv_zip_invalido", "Zip inválido", "Invalid zip", "Zip inválido")
        _t("sv_zip_sem_destino", "O zip não diz de qual jogo é (sem moonsave.json): abra a pasta do jogo e importe de lá", "The zip does not say which game it is for (no moonsave.json): open the game folder and import from there", "El zip no dice de qué juego es (sin moonsave.json): abre la carpeta del juego e importa desde allí")
        _t("sv_zip_vazio", "Nenhum arquivo importado", "No files imported", "Ningún archivo importado")
        _t("sv_importado", "Importado", "Imported", "Importado")
        _t("sv_migrados", "saves do MOON. migrados para /sdcard/MOON/saves/moon", "MOON. saves moved to /sdcard/MOON/saves/moon", "saves de MOON. movidos a /sdcard/MOON/saves/moon")
        _t("tema_noite", "Preto e branco", "Black and white", "Blanco y negro")
        _t("tema_roxo", "Roxo", "Purple", "Morado")
        _t("tema_floresta", "Floresta", "Forest", "Bosque")
        _t("tema_custom", "Personalizado", "Custom", "Personalizado")
        _t("tema_personalizar", "Personalizar cores", "Customize colors", "Personalizar colores")
        _t("tema_restaurar", "Restaurar padrão (preto e branco)", "Restore default (black and white)", "Restaurar predeterminado (blanco y negro)")
        _t("tema_restaurado", "Tema padrão restaurado", "Default theme restored", "Tema predeterminado restaurado")
        _t("cores_titulo", "Cores do tema", "Theme colors", "Colores del tema")
        _t("cor_0", "Fundo", "Background", "Fondo")
        _t("cor_1", "Superfície", "Surface", "Superficie")
        _t("cor_2", "Texto", "Text", "Texto")
        _t("cor_3", "Texto secundário", "Secondary text", "Texto secundario")
        _t("cor_4", "Destaque", "Accent", "Acento")
        _t("cor_5", "Botão", "Button", "Botón")
        _t("cor_6", "Botão pressionado", "Pressed button", "Botón pulsado")
        _t("cor_7", "Barra", "Bar", "Barra")
        _t("cor_8", "Borda", "Border", "Borde")
        _t("cor_9", "Selo do motor", "Engine badge", "Sello del motor")
