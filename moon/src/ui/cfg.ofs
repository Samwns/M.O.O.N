        _t("cor_hex", "Hex (digite 6 dígitos)", "Hex (type 6 digits)", "Hex (escribe 6 dígitos)")
    }
}

vein tr(k: obsidian) -> obsidian { return cfg.tr_lang(k, cfg.lang) }
