        _t("pl_nao_instalado", "Instale o plugin pela tela Plugins", "Install the plugin from the Plugins screen", "Instala el plugin desde la pantalla Plugins")
        _t("pl_motor_rpgm_desc", "Roda jogos HTML5 do RPG Maker MV e MZ numa WebView em tela cheia, com saves exportados para /sdcard/MOON/saves/rpgm/.", "Runs HTML5 RPG Maker MV and MZ games in a full-screen WebView, with saves exported to /sdcard/MOON/saves/rpgm/.", "Ejecuta juegos HTML5 de RPG Maker MV y MZ en un WebView a pantalla completa, con saves exportados a /sdcard/MOON/saves/rpgm/.")
        _t("pl_motor_tyrano_desc", "Roda jogos HTML5 do TyranoBuilder/TyranoScript numa WebView em tela cheia, com saves exportados para /sdcard/MOON/saves/tyrano/.", "Runs HTML5 TyranoBuilder/TyranoScript games in a full-screen WebView, with saves exported to /sdcard/MOON/saves/tyrano/.", "Ejecuta juegos HTML5 de TyranoBuilder/TyranoScript en un WebView a pantalla completa, con saves exportados a /sdcard/MOON/saves/tyrano/.")
        _t("pl_motor_godot_desc", "Jogos Godot com .pck: o plugin traz o motor da versão exata do jogo. Pacotes por versão (godot-4.7.2…).", "Godot games with .pck: the plugin brings the engine of the game's exact version. One package per version (godot-4.7.2…).", "Juegos Godot con .pck: el plugin trae el motor de la versión exacta del juego. Un paquete por versión (godot-4.7.2…).")
        _t("det_rpgm", "Pasta com www/js/rpg_core.js ou js/rpg_core.js (MV) ou js/rmmz_core.js (MZ). A versão vem de Utils.RPGMAKER_VERSION.", "Folder with www/js/rpg_core.js or js/rpg_core.js (MV) or js/rmmz_core.js (MZ). The version comes from Utils.RPGMAKER_VERSION.", "Carpeta con www/js/rpg_core.js o js/rpg_core.js (MV) o js/rmmz_core.js (MZ). La versión sale de Utils.RPGMAKER_VERSION.")
        _t("det_tyrano", "Pasta com tyrano/ e data/scenario, ou index.html que cite tyrano.", "Folder with tyrano/ and data/scenario, or an index.html that mentions tyrano.", "Carpeta con tyrano/ y data/scenario, o index.html que mencione tyrano.")
        _t("det_godot", "Pasta com um .pck (cabeçalho GDPC); a versão vem do cabeçalho do .pck.", "Folder with a .pck (GDPC header); the version comes from the .pck header.", "Carpeta con un .pck (cabecera GDPC); la versión sale de la cabecera del .pck.")
