<?xml version="1.0" encoding="utf-8"?>
<!-- Plugin Ren'Py do M.O.O.N: APK de terceiros (Java do SDL2/Ren'Py + main.py).
     Não é parte do M.O.O.N (que continua hasCode=false). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fixedseat.moon.plugin.renpy"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="M.O.O.N Ren'Py"
        android:hasCode="true"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false">

        <activity
            android:name="org.renpy.android.PythonSDLActivity"
            android:label="M.O.O.N Ren'Py"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="com.fixedseat.moon.plugin.renpy.LAUNCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
